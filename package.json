{
  "name": "pi-for-vscode",
  "displayName": "pi for VSCode",
  "version": "0.12.0",
  "description": "在编辑器区分屏打开 pi 终端，并把编辑器上下文注入 pi（个人自用）",
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "license": "MIT",
  "publisher": "local",
  "type": "module",
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "vp build",
    "watch": "vp build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.110.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.9.0",
    "vite-plus": "^0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "pi-for-vscode.openTerminal",
        "title": "pi：打开终端会话",
        "icon": {
          "light": "media/pi.svg",
          "dark": "media/pi-dark.svg"
        }
      },
      {
        "command": "pi-for-vscode.checkUpdate",
        "title": "pi：检查更新"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pi-for-vscode.openTerminal",
          "group": "navigation",
          "when": "resourceScheme == 'file'"
        },
        {
          "command": "pi-for-vscode.openTerminal",
          "group": "navigation",
          "when": "resourceScheme == 'vscode-terminal'"
        }
      ],
      "commandPalette": [
        {
          "command": "pi-for-vscode.openTerminal"
        }
      ]
    },
    "configuration": {
      "title": "pi for VSCode",
      "properties": {
        "pi-for-vscode.context.enabled": {
          "type": "boolean",
          "default": true,
          "description": "把活动编辑器的文件与选区在变化时注入 pi 对话（工作区仍写入系统提示词）"
        },
        "pi-for-vscode.context.maxLines": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "注入的选区最大行数（超出截断）"
        },
        "pi-for-vscode.terminal.splitRight": {
          "type": "boolean",
          "default": true,
          "description": "在编辑器区右侧分屏打开终端（false 则使用默认终端位置）"
        },
        "pi-for-vscode.update.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启动时自动检查扩展更新"
        },
        "pi-for-vscode.update.channel": {
          "type": "string",
          "enum": [
            "stable",
            "prerelease"
          ],
          "default": "stable",
          "description": "更新检查频道：stable 仅正式版，prerelease 包含预发布版"
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=20",
    "vscode": "^1.110.0"
  }
}
