{
  "name": "pi-for-vscode",
  "displayName": "pi for VSCode",
  "version": "0.13.0",
  "description": "在辅助侧栏管理 pi 会话，于编辑器区打开原生终端，并注入编辑器上下文（个人自用）",
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "license": "MIT",
  "publisher": "local",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "vp build",
    "watch": "vp build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-vitest.mjs run",
    "package": "vsce package --allow-missing-repository"
  },
  "dependencies": {
    "@xterm/addon-serialize": "0.15.0-beta.292",
    "@xterm/headless": "6.1.0-beta.292",
    "@xterm/xterm": "6.1.0-beta.292",
    "node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.110.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.9.0",
    "vite-plus": "^0.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "pi-for-vscode.openTerminal",
        "title": "pi：打开会话",
        "icon": {
          "light": "media/pi.svg",
          "dark": "media/pi-dark.svg"
        }
      },
      {
        "command": "pi-for-vscode.newSession",
        "title": "pi：新建会话",
        "icon": "$(add)"
      },
      {
        "command": "pi-for-vscode.checkUpdate",
        "title": "pi：检查更新"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "pi-for-vscode",
          "title": "pi",
          "icon": "media/pi.svg"
        }
      ]
    },
    "views": {
      "pi-for-vscode": [
        {
          "type": "webview",
          "id": "pi-for-vscode.sessionView",
          "name": "会话",
          "icon": "media/pi.svg",
          "visibility": "collapsed"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "pi-for-vscode.openTerminal",
          "group": "navigation",
          "when": "resourceScheme == 'file'"
        },
        {
          "command": "pi-for-vscode.openTerminal",
          "group": "navigation",
          "when": "resourceScheme == 'vscode-terminal'"
        }
      ],
      "commandPalette": [
        {
          "command": "pi-for-vscode.openTerminal"
        },
        {
          "command": "pi-for-vscode.newSession"
        }
      ]
    },
    "configuration": {
      "title": "pi for VSCode",
      "properties": {
        "pi-for-vscode.context.enabled": {
          "type": "boolean",
          "default": true,
          "description": "把活动编辑器的文件与选区在变化时注入 pi 对话（工作区仍写入系统提示词）"
        },
        "pi-for-vscode.context.maxLines": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "注入的选区最大行数（超出截断）"
        },
        "pi-for-vscode.command": {
          "type": "string",
          "default": "pi",
          "description": "启动 pi 用的可执行文件名或绝对路径。保持 pi 即可自动探测（含 Windows 的 pi.cmd）"
        },
        "pi-for-vscode.terminal.closeBehavior": {
          "type": "string",
          "enum": [
            "detach",
            "stop"
          ],
          "enumDescriptions": [
            "关闭终端只拆掉画面，pi 进程继续跑，可从列表重建终端",
            "关闭终端时结束 pi 进程"
          ],
          "default": "detach",
          "description": "关闭 pi 终端时的行为"
        },
        "pi-for-vscode.update.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启动时自动检查扩展更新"
        },
        "pi-for-vscode.update.channel": {
          "type": "string",
          "enum": [
            "stable",
            "prerelease"
          ],
          "default": "stable",
          "description": "更新检查频道：stable 仅正式版，prerelease 包含预发布版"
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=20",
    "vscode": "^1.110.0"
  },
  "allowScripts": {
    "node-pty@*": true
  }
}
